@model MultiShop.WebUI.Models.Basket.CartViewModel

@{
    ViewData["Title"] = "Sepetim";
    ViewData["Breadcrumbs"] = new BreadcrumbItemViewModel[]
    {
        new("Ana Sayfa", "Home", "Index"),
        new("Sepetim")
    };
}

<div class="container-fluid"><div class="row px-xl-5">
    <section class="col-lg-8 table-responsive mb-5">
        <table class="table table-light table-borderless table-hover text-center mb-0">
            <thead class="thead-dark"><tr><th>Ürün</th><th>Fiyat</th><th>Adet</th><th>Toplam</th><th>Kaldır</th></tr></thead>
            <tbody class="align-middle">
                @if (Model.Basket.BasketItems.Count == 0)
                {
                    <tr><td colspan="5" class="py-5">Sepetinizde henüz ürün bulunmuyor.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Basket.BasketItems)
                    {
                        <tr><td class="align-middle"><img src="@item.ProductImageUrl" alt="@item.ProductName" style="width: 50px;" /> @item.ProductName</td><td class="align-middle">@item.Price.ToString("N2") ₺</td><td class="align-middle">@item.Quantity</td><td class="align-middle">@item.LineTotal.ToString("N2") ₺</td><td class="align-middle"><form asp-action="Remove" method="post"><input type="hidden" name="productId" value="@item.ProductId" /><button class="btn btn-sm btn-primary" type="submit" aria-label="@item.ProductName ürününü sepetten kaldır"><i class="fa fa-times"></i></button></form></td></tr>
                    }
                }
            </tbody>
        </table>
    </section>
    <aside class="col-lg-4">

            <partial name="_CouponForm" />

            @if (TempData["CouponError"] is string couponError)
            {
                <div class="alert alert-danger mt-3">
                    @couponError
                </div>
            }

        <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Sepet Özeti</span></h5>
        <div class="bg-light p-30 mb-5"><div class="border-bottom pb-2"><div class="d-flex justify-content-between mb-3"><h6>Ara Toplam</h6><h6>@Model.Subtotal.ToString("N2") ₺</h6></div>@if (Model.HasDiscount){<div class="d-flex justify-content-between mb-3"><h6 class="font-weight-medium">Kupon (@Model.CouponCode - %@Model.DiscountRate)</h6><h6 class="font-weight-medium text-success">-@Model.DiscountAmount.ToString("N2") ₺</h6></div><div class="d-flex justify-content-between mb-3"><h6 class="font-weight-medium">İndirimli Ara Toplam</h6><h6 class="font-weight-medium">@Model.DiscountedSubtotal.ToString("N2") ₺</h6></div>}<div class="d-flex justify-content-between mb-3"><h6 class="font-weight-medium">KDV (%10)</h6><h6 class="font-weight-medium">@Model.Tax.ToString("N2") ₺</h6></div><div class="d-flex justify-content-between"><h6 class="font-weight-medium">Kargo</h6><h6 class="font-weight-medium">Ücretsiz</h6></div></div><div class="pt-2"><div class="d-flex justify-content-between mt-2"><h5>Toplam</h5><h5>@Model.TotalWithTax.ToString("N2") ₺</h5></div>@if (Model.Basket.BasketItems.Count > 0){<a asp-controller="Order" asp-action="Index" class="btn btn-block btn-primary font-weight-bold my-3 py-3">Ödemeye Geç</a>}else{<button class="btn btn-block btn-primary font-weight-bold my-3 py-3" type="button" disabled>Ödemeye Geç</button>}</div></div>
    </aside>
</div></div>
