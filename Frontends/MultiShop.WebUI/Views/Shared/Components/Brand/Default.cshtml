<div class="container-fluid py-5">
    <div class="row px-xl-5">
        <div class="col">
            <div class="owl-carousel vendor-carousel">
                @for (var imageIndex = 1; imageIndex <= 8; imageIndex++)
                {
                    <div class="bg-light p-4"><img src="~/theme/img/vendor-@(imageIndex).jpg" alt="Marka @imageIndex" /></div>
                }
            </div>
        </div>
    </div>
</div>
