@model IReadOnlyList<ResultSpecialOfferDto>

@if (Model.Count == 0)
{
    <div class="product-offer mb-30 bg-dark d-flex align-items-center justify-content-center" style="height: 430px;">
        <div class="offer-text text-center">
            <h3 class="text-white mb-3">Özel Teklifler Yakında</h3>
            <p class="text-white mb-0">Yeni fırsatlar için bizi takipte kal.</p>
        </div>
    </div>
}
else
{
    @foreach (var specialOffer in Model)
    {
        <div class="product-offer mb-30" style="height: 200px;">
            <img class="img-fluid" src="@specialOffer.ImageUrl" alt="@specialOffer.Title" />
            <div class="offer-text">
                <h6 class="text-white text-uppercase">@specialOffer.SubTitle</h6>
                <h3 class="text-white mb-3">@specialOffer.Title</h3>
                <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Alışverişe Başla</a>
            </div>
        </div>
    }
}
