@model IReadOnlyList<ResultAboutDto>
<footer class="container-fluid bg-dark text-secondary mt-5 pt-5">
    <div class="row px-xl-5 pt-5">
        @foreach (var about in Model)
        {
            <div class="col-lg-4 col-md-12 mb-5 pr-3 pr-xl-5"><h5 class="text-secondary text-uppercase mb-4">MultiShop</h5><p class="mb-4">@about.Description</p><p class="mb-2"><i class="fa fa-map-marker-alt text-primary mr-3"></i>@about.Address</p><p class="mb-2"><i class="fa fa-envelope text-primary mr-3"></i>@about.Email</p><p class="mb-0"><i class="fa fa-phone-alt text-primary mr-3"></i>@about.Phone</p></div>
        }
    </div>
    <div class="row border-top mx-xl-5 py-4" style="border-color: rgba(256, 256, 256, .1) !important;">
        <div class="col-md-6 px-xl-0 text-center text-md-left text-secondary">&copy; @DateTime.UtcNow.Year MultiShop</div>
    </div>
</footer>
