@model MultiShop.WebUI.Models.Basket.CartViewModel

<h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Sipariş Özeti</span></h5>
<div class="bg-light p-30 mb-5"><div class="border-bottom"><h6 class="mb-3">Ürünler</h6>@foreach (var item in Model.Basket.BasketItems){<div class="d-flex justify-content-between"><p>@item.ProductName <span class="text-muted">x @item.Quantity</span></p><p>@item.LineTotal.ToString("N2") ₺</p></div>}</div><div class="border-bottom pt-3 pb-2"><div class="d-flex justify-content-between mb-3"><h6>Ara Toplam</h6><h6>@Model.Subtotal.ToString("N2") ₺</h6></div><div class="d-flex justify-content-between mb-3"><h6 class="font-weight-medium">KDV</h6><h6 class="font-weight-medium">@Model.Tax.ToString("N2") ₺</h6></div><div class="d-flex justify-content-between"><h6 class="font-weight-medium">Kargo</h6><h6 class="font-weight-medium">Ücretsiz</h6></div></div><div class="pt-2"><div class="d-flex justify-content-between mt-2"><h5>Toplam</h5><h5>@Model.TotalWithTax.ToString("N2") ₺</h5></div></div></div>
