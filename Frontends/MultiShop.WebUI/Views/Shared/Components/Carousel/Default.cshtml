@model IReadOnlyList<ResultFeatureSliderDto>

<div class="container-fluid mb-3">
    <div class="row px-xl-5">
        <div class="col-lg-8">
            <div id="header-carousel" class="carousel slide carousel-fade mb-30 mb-lg-0" data-ride="carousel">
                @if (Model.Count > 1)
                {
                    <ol class="carousel-indicators">
                        @for (var index = 0; index < Model.Count; index++)
                        {
                            <li data-target="#header-carousel"
                                data-slide-to="@index"
                                class="@(index == 0 ? "active" : string.Empty)"></li>
                        }
                    </ol>
                }
                <div class="carousel-inner">
                    @if (Model.Count == 0)
                    {
                        <div class="carousel-item position-relative active bg-dark" style="height: 430px;">
                            <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                                <div class="p-3 text-center" style="max-width: 700px;">
                                    <h1 class="display-4 text-white mb-3">Yeni koleksiyon yakında</h1>
                                    <p class="mx-md-5 px-5">Öne çıkan görseller hazır olduğunda burada gösterilecek.</p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @for (var index = 0; index < Model.Count; index++)
                        {
                            var featureSlider = Model[index];
                            <div class="carousel-item position-relative @(index == 0 ? "active" : string.Empty)" style="height: 430px;">
                                <img class="position-absolute w-100 h-100"
                                     src="@featureSlider.ImageUrl"
                                     alt="@featureSlider.Title"
                                     style="object-fit: cover;" />
                                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                                    <div class="p-3" style="max-width: 700px;">
                                        <h1 class="display-4 text-white mb-3 animate__animated animate__fadeInDown">@featureSlider.Title</h1>
                                        <p class="mx-md-5 px-5 animate__animated animate__bounceIn">@featureSlider.Description</p>
                                        <a class="btn btn-outline-light py-2 px-4 mt-3 animate__animated animate__fadeInUp" asp-controller="Products" asp-action="Index">Ürünleri Gör</a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            @await Component.InvokeAsync("SpecialOffer")
        </div>
    </div>
</div>
