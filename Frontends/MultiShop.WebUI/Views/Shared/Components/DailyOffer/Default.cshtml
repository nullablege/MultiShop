@model IReadOnlyList<ResultOfferDiscountDto>

<div class="container-fluid pt-5 pb-3">
    <div class="row px-xl-5">
        @foreach (var offerDiscount in Model)
        {
            <div class="col-md-6 pb-1">
                <div class="product-offer mb-30" style="height: 300px;">
                    <img class="img-fluid" src="@offerDiscount.ImageUrl" alt="@offerDiscount.Title" />
                    <div class="offer-text">
                        <h6 class="text-white text-uppercase">@offerDiscount.SubTitle</h6>
                        <h3 class="text-white mb-3">@offerDiscount.Title</h3>
                        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">@offerDiscount.ButtonTitle</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
