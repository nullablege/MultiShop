<!DOCTYPE html>
<html lang="tr">
<partial name="_HeadPartial" />
<body>
    @await Component.InvokeAsync("Topbar")

    <div class="container-fluid">
        <div class="row align-items-center bg-light py-3 px-xl-5 d-none d-lg-flex">
            <div class="col-lg-4">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                    <span class="h1 text-uppercase text-primary bg-dark px-2">Multi</span>
                    <span class="h1 text-uppercase text-dark bg-primary px-2 ml-n1">Shop</span>
                </a>
            </div>
            <div class="col-lg-4 col-6 text-left">
                <form>
                    <div class="input-group">
                        <input class="form-control" placeholder="Ürün ara" type="search" />
                        <div class="input-group-append">
                            <span class="input-group-text bg-transparent text-primary"><i class="fa fa-search"></i></span>
                        </div>
                    </div>
                </form>
            </div>
            <div class="col-lg-4 col-6 text-right">
                <p class="m-0">Müşteri Hizmetleri</p>
                <h5 class="m-0">Yakında</h5>
            </div>
        </div>
    </div>

    <div class="container-fluid bg-dark mb-30">
        <div class="row px-xl-5">
            <div class="col-lg-3 d-none d-lg-block"></div>
            <div class="col-lg-9">
                <nav class="navbar navbar-expand-lg bg-dark navbar-dark py-3 py-lg-0 px-0">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none d-block d-lg-none">
                        <span class="h1 text-uppercase text-dark bg-light px-2">Multi</span>
                        <span class="h1 text-uppercase text-light bg-primary px-2 ml-n1">Shop</span>
                    </a>
                    <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
                        <div class="navbar-nav mr-auto py-0">
                            <a asp-controller="Home" asp-action="Index" class="nav-item nav-link active">Ana Sayfa</a>
                            <a class="nav-item nav-link" href="#">Ürünler</a>
                            <a class="nav-item nav-link" href="#">İletişim</a>
                        </div>
                        <div class="navbar-nav ml-auto py-0 d-none d-lg-block">
                            <a class="btn px-0" href="#"><i class="fas fa-heart text-primary"></i><span class="badge text-secondary border border-secondary rounded-circle" style="padding-bottom: 2px;">0</span></a>
                            <a class="btn px-0 ml-3" href="#"><i class="fas fa-shopping-cart text-primary"></i><span class="badge text-secondary border border-secondary rounded-circle" style="padding-bottom: 2px;">0</span></a>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="container-fluid bg-dark text-secondary mt-5 pt-5">
        <div class="row px-xl-5 pt-5">
            <div class="col-lg-4 col-md-12 mb-5 pr-3 pr-xl-5">
                <h5 class="text-secondary text-uppercase mb-4">MultiShop</h5>
                <p class="mb-4">Mikroservis tabanlı alışveriş uygulaması.</p>
            </div>
        </div>
        <div class="row border-top mx-xl-5 py-4" style="border-color: rgba(256, 256, 256, .1) !important;">
            <div class="col-md-6 px-xl-0 text-center text-md-left text-secondary">&copy; @DateTime.UtcNow.Year MultiShop</div>
        </div>
    </footer>

    <a href="#" class="btn btn-primary back-to-top"><i class="fa fa-angle-double-up"></i></a>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
    <script src="~/theme/lib/easing/easing.min.js"></script>
    <script src="~/theme/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/theme/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
