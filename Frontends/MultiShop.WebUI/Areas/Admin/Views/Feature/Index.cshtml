@model IReadOnlyList<ResultFeatureDto>

@{
    ViewData["Title"] = "Öne Çıkan Alan";
    var rowNumber = 0;
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Öne Çıkan Alan Listesi</h3>
        <div class="box-tools pull-right">
            <a asp-action="CreateFeature" class="btn btn-primary btn-sm"><i class="fa fa-plus"></i> Yeni Alan</a>
        </div>
    </div>
    <div class="box-body table-responsive no-padding">
        <table class="table table-hover">
            <thead><tr><th>#</th><th>Başlık</th><th>İkon</th><th class="text-right">İşlemler</th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted">Kayıtlı öne çıkan alan bulunamadı.</td></tr>
                }
                else
                {
                    @foreach (var feature in Model)
                    {
                        rowNumber++;
                        <tr>
                            <td>@rowNumber</td>
                            <td>@feature.Title</td>
                            <td><i class="@feature.Icon"></i> @feature.Icon</td>
                            <td class="text-right">
                                <a asp-action="UpdateFeature" asp-route-id="@feature.FeatureId" class="btn btn-success btn-sm">Güncelle</a>
                                <form asp-action="DeleteFeature" method="post" style="display: inline;">
                                    <input type="hidden" name="featureId" value="@feature.FeatureId" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Bu alanı silmek istediğine emin misin?');">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
