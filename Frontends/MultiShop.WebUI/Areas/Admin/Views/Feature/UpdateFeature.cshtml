@model UpdateFeatureDto

@{
    ViewData["Title"] = "Öne Çıkan Alanı Güncelle";
}

<form asp-action="UpdateFeature" method="post">
    <input type="hidden" asp-for="FeatureId" />
    <div class="box box-primary">
        <div class="box-header with-border"><h3 class="box-title">Öne çıkan alan bilgilerini güncelle</h3></div>
        <div class="box-body">
            <div class="form-group"><label asp-for="Title">Alan başlığı</label><input asp-for="Title" class="form-control" /></div>
            <div class="form-group"><label asp-for="Icon">Font Awesome sınıfı</label><input asp-for="Icon" class="form-control" /></div>
        </div>
        <div class="box-footer"><a asp-action="Index" class="btn btn-default">Listeye Dön</a><button type="submit" class="btn btn-primary pull-right"><i class="fa fa-save"></i> Değişiklikleri Kaydet</button></div>
    </div>
</form>
