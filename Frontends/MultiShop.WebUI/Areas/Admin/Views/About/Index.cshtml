@model IReadOnlyList<ResultAboutDto>
@{ ViewData["Title"] = "Hakkımızda"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
<div class="box"><div class="box-header with-border"><h3 class="box-title">Hakkımızda Bilgisi</h3><div class="box-tools pull-right"><a asp-action="CreateAbout" class="btn btn-primary">Yeni Kayıt</a></div></div><div class="box-body table-responsive no-padding"><table class="table table-hover"><tr><th>Açıklama</th><th>Adres</th><th>E-posta</th><th>Telefon</th><th>İşlemler</th></tr>@foreach (var about in Model) { <tr><td>@about.Description</td><td>@about.Address</td><td>@about.Email</td><td>@about.Phone</td><td><a asp-action="UpdateAbout" asp-route-id="@about.AboutId" class="btn btn-warning btn-sm">Güncelle</a> <form asp-action="DeleteAbout" method="post" class="d-inline"><input type="hidden" name="aboutId" value="@about.AboutId" /><button class="btn btn-danger btn-sm">Sil</button></form></td></tr> }</table></div></div>
