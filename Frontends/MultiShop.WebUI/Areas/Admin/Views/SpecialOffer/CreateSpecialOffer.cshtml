@model CreateSpecialOfferDto

@{
    ViewData["Title"] = "Yeni Özel Teklif";
}

<form asp-action="CreateSpecialOffer" method="post">
    <div class="box box-primary">
        <div class="box-header with-border">
            <h3 class="box-title">Yeni özel teklif bilgileri</h3>
        </div>
        <div class="box-body">
            <div class="form-group">
                <label asp-for="Title">Teklif başlığı</label>
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="SubTitle">Teklif alt başlığı</label>
                <input asp-for="SubTitle" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl">Teklif görseli adresi</label>
                <input asp-for="ImageUrl" type="url" class="form-control" placeholder="https://..." />
            </div>
        </div>
        <div class="box-footer">
            <a asp-action="Index" class="btn btn-default">Listeye Dön</a>
            <button type="submit" class="btn btn-primary pull-right">
                <i class="fa fa-save"></i> Teklifi Kaydet
            </button>
        </div>
    </div>
</form>
