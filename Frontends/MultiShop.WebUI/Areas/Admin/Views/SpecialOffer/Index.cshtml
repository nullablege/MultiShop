@model IReadOnlyList<ResultSpecialOfferDto>

@{
    ViewData["Title"] = "Özel Teklifler";
    var rowNumber = 0;
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Özel Teklif ve Günün Fırsatı Listesi</h3>
        <div class="box-tools pull-right">
            <a asp-action="CreateSpecialOffer" class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> Yeni Teklif
            </a>
        </div>
    </div>
    <div class="box-body table-responsive no-padding">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Teklif Başlığı</th>
                    <th>Teklif Alt Başlığı</th>
                    <th class="text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">
                            Kayıtlı özel teklif bulunamadı.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var specialOffer in Model)
                    {
                        rowNumber++;
                        <tr>
                            <td>@rowNumber</td>
                            <td>@specialOffer.Title</td>
                            <td>@specialOffer.SubTitle</td>
                            <td class="text-right">
                                <a asp-action="UpdateSpecialOffer"
                                   asp-route-id="@specialOffer.SpecialOfferId"
                                   class="btn btn-success btn-sm">
                                    Güncelle
                                </a>
                                <form asp-action="DeleteSpecialOffer" method="post" style="display: inline;">
                                    <input type="hidden" name="specialOfferId" value="@specialOffer.SpecialOfferId" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Bu özel teklifi silmek istediğine emin misin?');">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
