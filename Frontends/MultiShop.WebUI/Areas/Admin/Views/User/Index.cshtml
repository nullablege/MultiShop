@model IReadOnlyList<AdminUserListItemDto>

@{
    ViewData["Title"] = "Kullanıcılar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var rowNumber = 0;
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Kullanıcı Listesi</h3>
    </div>
    <div class="box-body table-responsive no-padding">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ad Soyad</th>
                    <th>Kullanıcı Adı</th>
                    <th>E-posta</th>
                    <th class="text-right">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">Kayıtlı kullanıcı bulunamadı.</td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model)
                    {
                        rowNumber++;
                        var name = $"{user.Name} {user.Surname}".Trim();
                        <tr>
                            <td>@rowNumber</td>
                            <td>@(string.IsNullOrWhiteSpace(name) ? "-" : name)</td>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td class="text-right">
                                <a asp-action="CargoProfile"
                                   asp-route-userId="@user.Id"
                                   class="btn btn-info btn-sm">Kargo Profili</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
