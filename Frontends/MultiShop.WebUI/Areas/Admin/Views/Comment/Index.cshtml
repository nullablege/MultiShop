@model IReadOnlyList<AdminCommentListDto>

@{
    ViewData["Title"] = "Yorumlar";
    var rowNumber = 0;
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Yorum Listesi</h3>
    </div>
    <div class="box-body table-responsive no-padding">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Kullanıcı</th>
                    <th>Yorum</th>
                    <th>Puan</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            Kayıtlı yorum bulunamadı.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var comment in Model)
                    {
                        rowNumber++;
                        <tr>
                            <td>@rowNumber</td>
                            <td>@comment.NameSurname</td>
                            <td>@comment.CommentDetail</td>
                            <td>@comment.Rating / 5</td>
                            <td>@comment.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @if (comment.Status)
                                {
                                    <span class="label label-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="label label-warning">Onay Bekliyor</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
