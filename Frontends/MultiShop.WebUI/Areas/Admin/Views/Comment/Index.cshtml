@model IReadOnlyList<AdminCommentListDto>

@{
    ViewData["Title"] = "Yorumlar";
    var rowNumber = 0;
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Yorum Listesi</h3>
    </div>
    <div class="box-body table-responsive no-padding">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Kullanıcı</th>
                    <th>Yorum</th>
                    <th>Puan</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th class="text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            Kayıtlı yorum bulunamadı.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var comment in Model)
                    {
                        rowNumber++;
                        <tr>
                            <td>@rowNumber</td>
                            <td>@comment.NameSurname</td>
                            <td>@comment.CommentDetail</td>
                            <td>@comment.Rating / 5</td>
                            <td>@comment.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @if (comment.Status)
                                {
                                    <span class="label label-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="label label-warning">Onay Bekliyor</span>
                                }
                            </td>
                            <td class="text-right">
                                <a asp-action="UpdateComment"
                                   asp-route-id="@comment.UserCommentId"
                                   class="btn btn-success btn-sm">
                                    Durumu Güncelle
                                </a>
                                <form asp-action="DeleteComment" method="post" style="display: inline;">
                                    <input type="hidden" name="userCommentId" value="@comment.UserCommentId" />
                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('Bu yorumu silmek istediğine emin misin?');">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
