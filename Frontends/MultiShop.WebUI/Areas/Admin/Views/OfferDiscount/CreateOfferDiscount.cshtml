@model CreateOfferDiscountDto
@{ ViewData["Title"] = "İndirim Teklifi Ekle"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
<div class="box box-primary"><form asp-action="CreateOfferDiscount" method="post"><div class="box-body">
