@model CreateBrandDto
@{ ViewData["Title"] = "Marka Ekle"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
<div class="box box-primary"><form asp-action="CreateBrand" method="post"><div class="box-body"><div class="form-group"><label asp-for="BrandName">Marka adı</label><input asp-for="BrandName" class="form-control" /></div><div class="form-group"><label asp-for="ImageUrl">Görsel adresi</label><input asp-for="ImageUrl" type="url" class="form-control" /></div></div><div class="box-footer"><a asp-action="Index" class="btn btn-default">Listeye Dön</a><button type="submit" class="btn btn-primary pull-right">Kaydet</button></div></form></div>
