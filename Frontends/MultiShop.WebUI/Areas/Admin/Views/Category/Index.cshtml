@model IReadOnlyList<MultiShop.WebUI.Models.Catalog.CategoryDTOs.ResultCategoryDto>

@{
    ViewData["Title"] = "Kategoriler";
    var rowNumber = 0;
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Kategori Listesi</h3>
        <div class="box-tools pull-right">
            <a asp-action="CreateCategory" class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> Yeni Kategori
            </a>
        </div>
    </div>
    <div class="box-body table-responsive no-padding">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Kategori Adı</th>
                    <th class="text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">
                            Kayıtlı kategori bulunamadı.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var category in Model)
                    {
                        rowNumber++;
                        <tr>
                            <td>@rowNumber</td>
                            <td>@category.CategoryName</td>
                            <td class="text-right">
                                <a asp-action="UpdateCategory"
                                   asp-route-id="@category.CategoryId"
                                   class="btn btn-success btn-sm">
                                    Güncelle
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
