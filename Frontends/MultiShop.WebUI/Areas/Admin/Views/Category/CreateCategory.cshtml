@model CreateCategoryDto
@{
    ViewData["Title"] = "Yeni Kategori";
}

<form asp-action="CreateCategory" method="post">
    <div class="box box-primary">
        <div class="box-header with-border">
            <h3 class="box-title">Yeni kategori bilgileri</h3>
        </div>
        <div class="box-body">
            <div class="form-group">
                <label asp-for="CategoryName">Kategori adı</label>
                <input id="categoryName" asp-for="CategoryName" type="text" class="form-control" placeholder="Örn. Elektronik" />
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl">Kategori görseli adresi</label>
                <input asp-for="ImageUrl" type="url" class="form-control" placeholder="https://..." />
            </div>
        </div>
        <div class="box-footer">
            <a asp-action="Index" class="btn btn-default">Listeye Dön</a>
            <button type="submit" class="btn btn-primary pull-right">
                <i class="fa fa-save"></i> Kategoriyi Kaydet
            </button>
        </div>
    </div>
</form>
