@{
    ViewData["Title"] = "Yeni Kategori";
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Yeni kategori bilgileri</h3>
    </div>
    <div class="box-body">
        <div class="form-group">
            <label for="categoryName">Kategori adı</label>
            <input id="categoryName" type="text" class="form-control" placeholder="Örn. Elektronik" />
        </div>
        <div class="form-group">
            <label for="imageUrl">Görsel adresi</label>
            <input id="imageUrl" type="url" class="form-control" placeholder="https://..." />
        </div>
        <div class="callout callout-info">
            <p>Kaydetme işlemi, Catalog API form sözleşmesi eklendiğinde etkinleşecek.</p>
        </div>
    </div>
    <div class="box-footer">
        <a asp-action="Index" class="btn btn-default">Listeye Dön</a>
        <button type="button" class="btn btn-primary pull-right" disabled>
            <i class="fa fa-save"></i> Kategoriyi Kaydet
        </button>
    </div>
</div>
