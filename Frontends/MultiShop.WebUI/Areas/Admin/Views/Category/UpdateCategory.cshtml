@{
    ViewData["Title"] = "Kategori Güncelle";
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Kategori bilgilerini güncelle</h3>
    </div>
    <div class="box-body">
        <div class="form-group">
            <label>Kategori kimliği</label>
            <input type="text" class="form-control" value="@ViewData["CategoryId"]" readonly />
        </div>
        <div class="form-group">
            <label for="categoryName">Kategori adı</label>
            <input id="categoryName" type="text" class="form-control" placeholder="Catalog API'den yüklenecek" />
        </div>
        <div class="form-group">
            <label for="imageUrl">Görsel adresi</label>
            <input id="imageUrl" type="url" class="form-control" placeholder="Catalog API'den yüklenecek" />
        </div>
        <div class="callout callout-info">
            <p>Mevcut kategori verisi ve güncelleme isteği, Catalog API bağlantısıyla eklenecek.</p>
        </div>
    </div>
    <div class="box-footer">
        <a asp-action="Index" class="btn btn-default">Listeye Dön</a>
        <button type="button" class="btn btn-primary pull-right" disabled>
            <i class="fa fa-save"></i> Değişiklikleri Kaydet
        </button>
    </div>
</div>
