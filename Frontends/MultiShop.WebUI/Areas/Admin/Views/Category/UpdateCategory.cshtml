@model UpdateCategoryDto

@{
    ViewData["Title"] = "Kategori Güncelle";
}

<form asp-action="UpdateCategory" method="post">
    <input type="hidden" asp-for="CategoryId" />

    <div class="box box-primary">
        <div class="box-header with-border">
            <h3 class="box-title">Kategori bilgilerini güncelle</h3>
        </div>
        <div class="box-body">
            <div class="form-group">
                <label asp-for="CategoryName">Kategori adı</label>
                <input asp-for="CategoryName" class="form-control" />
            </div>
        </div>
        <div class="box-footer">
            <a asp-action="Index" class="btn btn-default">Listeye Dön</a>
            <button type="submit" class="btn btn-primary pull-right">
                <i class="fa fa-save"></i> Değişiklikleri Kaydet
            </button>
        </div>
    </div>
</form>
