@model UpdateFeatureSliderDto

@{
    ViewData["Title"] = "Slider Görseli Güncelle";
}

<form asp-action="UpdateFeatureSlider" method="post">
    <input type="hidden" asp-for="FeatureSliderId" />
    <div class="box box-primary">
        <div class="box-header with-border">
            <h3 class="box-title">Öne çıkan slider görselini güncelle</h3>
        </div>
        <div class="box-body">
            <div class="form-group">
                <label asp-for="Title">Görsel başlığı</label>
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Description">Görsel açıklaması</label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl">Görsel adresi</label>
                <input asp-for="ImageUrl" type="url" class="form-control" />
            </div>
            <div class="checkbox">
                <label>
                    <input asp-for="IsActive" /> Aktif olarak yayınla
                </label>
            </div>
        </div>
        <div class="box-footer">
            <a asp-action="Index" class="btn btn-default">Listeye Dön</a>
            <button type="submit" class="btn btn-primary pull-right">
                <i class="fa fa-save"></i> Değişiklikleri Kaydet
            </button>
        </div>
    </div>
</form>
