@model IReadOnlyList<ResultFeatureSliderDto>

@{
    ViewData["Title"] = "Öne Çıkan Slider";
    var rowNumber = 0;
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Öne Çıkan Slider Listesi</h3>
        <div class="box-tools pull-right">
            <a asp-action="CreateFeatureSlider" class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> Yeni Slider Görseli
            </a>
        </div>
    </div>
    <div class="box-body table-responsive no-padding">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Başlık</th>
                    <th>Durum</th>
                    <th class="text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">
                            Kayıtlı slider görseli bulunamadı.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var featureSlider in Model)
                    {
                        rowNumber++;
                        <tr>
                            <td>@rowNumber</td>
                            <td>@featureSlider.Title</td>
                            <td>
                                @if (featureSlider.IsActive)
                                {
                                    <span class="label label-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="label label-default">Pasif</span>
                                }
                            </td>
                            <td class="text-right">
                                <a asp-action="UpdateFeatureSlider"
                                   asp-route-id="@featureSlider.FeatureSliderId"
                                   class="btn btn-success btn-sm">
                                    Güncelle
                                </a>
                                <form asp-action="DeleteFeatureSlider" method="post" style="display: inline;">
                                    <input type="hidden" name="featureSliderId" value="@featureSlider.FeatureSliderId" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Bu slider görselini silmek istediğine emin misin?');">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
