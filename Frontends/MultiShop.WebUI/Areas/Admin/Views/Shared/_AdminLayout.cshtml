<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MultiShop Admin</title>
    <link rel="stylesheet" href="~/admin-theme/html/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/admin-theme/html/dist/css/style.css" />
    <link rel="stylesheet" href="~/admin-theme/html/dist/et-line-font/et-line-font.css" />
    <link rel="stylesheet" href="~/admin-theme/html/dist/font-awesome/css/font-awesome.min.css" />
</head>
<body class="sidebar-mini">
    <div class="wrapper">
        <header class="main-header dark-bg">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="logo dark-bg">
                <span class="logo-mini"><b>MS</b></span>
                <span class="logo-lg"><b>Multi</b>Shop</span>
            </a>
            <nav class="navbar navbar-static-top">
                <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button" aria-label="Menüyü aç veya kapat">
                    <span class="sr-only">Menüyü aç veya kapat</span>
                </a>
                <div class="navbar-custom-menu">
                    <ul class="nav navbar-nav">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index"><i class="fa fa-home"></i> Mağazaya Dön</a></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-link navbar-btn">
                                    <i class="fa fa-sign-out"></i> Çıkış Yap
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>
        <aside class="main-sidebar">
            <section class="sidebar">
                <ul class="sidebar-menu" data-widget="tree">
                    <li class="header">YÖNETİM</li>
                    <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="icon-speedometer"></i> <span>Dashboard</span></a></li>
                    <li><a asp-area="Admin" asp-controller="Category" asp-action="Index"><i class="icon-grid"></i> <span>Kategoriler</span></a></li>
                    <li><a asp-area="Admin" asp-controller="Product" asp-action="Index"><i class="icon-basket"></i> <span>Ürünler</span></a></li>
                    <li><a asp-area="Admin" asp-controller="Product" asp-action="ProductListWithCategory"><i class="icon-list"></i> <span>Ürün & Kategori</span></a></li>
                    <li><a asp-area="Admin" asp-controller="FeatureSlider" asp-action="Index"><i class="icon-picture"></i> <span>Öne Çıkan Slider</span></a></li>
                    <li><a asp-area="Admin" asp-controller="SpecialOffer" asp-action="Index"><i class="icon-tag"></i> <span>Özel Teklifler</span></a></li>
                    <li><a asp-area="Admin" asp-controller="OfferDiscount" asp-action="Index"><i class="icon-tag"></i> <span>İndirim Teklifleri</span></a></li>
                    <li><a asp-area="Admin" asp-controller="Brand" asp-action="Index"><i class="icon-briefcase"></i> <span>Markalar</span></a></li>
                    <li><a asp-area="Admin" asp-controller="About" asp-action="Index"><i class="icon-info"></i> <span>Hakkımızda</span></a></li>
                    <li><a asp-area="Admin" asp-controller="Feature" asp-action="Index"><i class="icon-anchor"></i> <span>Öne Çıkan Alan</span></a></li>
                    <li><a asp-area="Admin" asp-controller="Comment" asp-action="Index"><i class="icon-bubble"></i> <span>Yorumlar</span></a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index"><i class="icon-basket"></i> <span>Mağazaya Dön</span></a></li>
                </ul>
            </section>
        </aside>
        <main class="content-wrapper">
            <section class="content-header"><h1>@ViewData["Title"]</h1></section>
            <section class="content">@RenderBody()</section>
        </main>
        <footer class="main-footer dark-bg">© @DateTime.UtcNow.Year MultiShop</footer>
    </div>
    <script src="~/admin-theme/html/dist/js/jquery.min.js"></script>
    <script src="~/admin-theme/html/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/admin-theme/html/dist/js/ovio.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
