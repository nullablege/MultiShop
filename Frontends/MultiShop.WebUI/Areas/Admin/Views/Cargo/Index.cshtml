@model IReadOnlyList<ResultCargoCompanyDto>

@{
    ViewData["Title"] = "Kargo Şirketleri";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var rowNumber = 0;
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Kargo Şirketi Listesi</h3>
        <div class="box-tools pull-right">
            <a asp-action="CreateCargoCompany" class="btn btn-primary btn-sm">Yeni Kargo Şirketi</a>
        </div>
    </div>
    <div class="box-body table-responsive no-padding">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Kargo Şirketi</th>
                    <th class="text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">Kayıtlı kargo şirketi bulunamadı.</td>
                    </tr>
                }
                else
                {
                    @foreach (var cargoCompany in Model)
                    {
                        rowNumber++;
                        <tr>
                            <td>@rowNumber</td>
                            <td>@cargoCompany.CargoCompanyName</td>
                            <td class="text-right">
                                <a asp-action="UpdateCargoCompany"
                                   asp-route-id="@cargoCompany.CargoCompanyId"
                                   class="btn btn-warning btn-sm">Güncelle</a>
                                <form asp-action="DeleteCargoCompany" method="post" style="display: inline;">
                                    <input type="hidden" name="cargoCompanyId" value="@cargoCompany.CargoCompanyId" />
                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('Bu kargo şirketini silmek istediğine emin misin?');">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
