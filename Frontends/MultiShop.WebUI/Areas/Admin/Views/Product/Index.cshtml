@model IReadOnlyList<ResultProductDto>

@{
    ViewData["Title"] = "Ürünler";
    var rowNumber = 0;
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Ürün Listesi</h3>
        <div class="box-tools pull-right">
            <a asp-action="CreateProduct" class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> Yeni Ürün
            </a>
        </div>
    </div>
    <div class="box-body table-responsive no-padding">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ürün Adı</th>
                    <th>Fiyat</th>
                    <th class="text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">
                            Kayıtlı ürün bulunamadı.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var product in Model)
                    {
                        rowNumber++;
                        <tr>
                            <td>@rowNumber</td>
                            <td>@product.ProductName</td>
                            <td>@product.ProductPrice.ToString("N2") ₺</td>
                            <td class="text-right">
                                <a asp-action="UpdateProduct"
                                   asp-route-id="@product.ProductId"
                                   class="btn btn-success btn-sm">
                                    Güncelle
                                </a>
                                <form asp-action="DeleteProduct" method="post" style="display: inline;">
                                    <input type="hidden" name="productId" value="@product.ProductId" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Bu ürünü silmek istediğine emin misin?');">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="box-footer">
        <a asp-action="ProductListWithCategory" class="btn btn-default">
            <i class="fa fa-list"></i> Kategori Bazlı Listeyi Gör
        </a>
    </div>
</div>
