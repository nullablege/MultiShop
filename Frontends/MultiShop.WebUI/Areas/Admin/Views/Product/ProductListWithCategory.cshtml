@model IReadOnlyList<ResultProductWithCategoryDto>

@{
    ViewData["Title"] = "Ürünler ve Kategoriler";
    var rowNumber = 0;
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Kategori Bazlı Ürün Listesi</h3>
    </div>
    <div class="box-body table-responsive no-padding">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ürün Adı</th>
                    <th>Kategori</th>
                    <th>Fiyat</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">
                            Kayıtlı ürün bulunamadı.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var product in Model)
                    {
                        rowNumber++;
                        <tr>
                            <td>@rowNumber</td>
                            <td>@product.ProductName</td>
                            <td>@(product.CategoryName ?? "Kategori bulunamadı")</td>
                            <td>@product.ProductPrice.ToString("N2") ₺</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="box-footer">
        <a asp-action="Index" class="btn btn-default">Ürün Listesine Dön</a>
    </div>
</div>
