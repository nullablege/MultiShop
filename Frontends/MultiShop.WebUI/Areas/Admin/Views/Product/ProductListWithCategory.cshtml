@{
    ViewData["Title"] = "Ürünler ve Kategoriler";
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Kategori Bazlı Ürün Listesi</h3>
    </div>
    <div class="box-body table-responsive no-padding">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ürün Adı</th>
                    <th>Kategori</th>
                    <th>Fiyat</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        Ürün-kategori sorgusu Catalog API'de hazırlandığında burada gösterilecek.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="box-footer">
        <a asp-action="Index" class="btn btn-default">Ürün Listesine Dön</a>
    </div>
</div>
