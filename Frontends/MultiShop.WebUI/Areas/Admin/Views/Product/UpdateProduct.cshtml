@{
    ViewData["Title"] = "Ürün Güncelle";
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Ürün bilgilerini güncelle</h3>
    </div>
    <div class="box-body">
        <div class="form-group">
            <label>Ürün kimliği</label>
            <input type="text" class="form-control" value="@ViewData["ProductId"]" readonly />
        </div>
        <div class="form-group">
            <label for="productName">Ürün adı</label>
            <input id="productName" type="text" class="form-control" placeholder="Catalog API'den yüklenecek" />
        </div>
        <div class="form-group">
            <label for="productPrice">Fiyat</label>
            <input id="productPrice" type="number" class="form-control" min="0" step="0.01" placeholder="Catalog API'den yüklenecek" />
        </div>
        <div class="form-group">
            <label for="productImageUrl">Görsel adresi</label>
            <input id="productImageUrl" type="url" class="form-control" placeholder="Catalog API'den yüklenecek" />
        </div>
        <div class="form-group">
            <label for="categoryId">Kategori</label>
            <select id="categoryId" class="form-control" disabled>
                <option>Kategoriler Catalog API bağlantısıyla yüklenecek</option>
            </select>
        </div>
        <div class="form-group">
            <label for="productDescription">Açıklama</label>
            <textarea id="productDescription" class="form-control" rows="5" placeholder="Catalog API'den yüklenecek"></textarea>
        </div>
        <div class="callout callout-info">
            <p>Mevcut ürün verisi ve güncelleme isteği, Catalog API bağlantısıyla eklenecek.</p>
        </div>
    </div>
    <div class="box-footer">
        <a asp-action="Index" class="btn btn-default">Listeye Dön</a>
        <button type="button" class="btn btn-primary pull-right" disabled>
            <i class="fa fa-save"></i> Değişiklikleri Kaydet
        </button>
    </div>
</div>
