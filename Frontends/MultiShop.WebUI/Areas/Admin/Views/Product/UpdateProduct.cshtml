@model UpdateProductDto

@{
    ViewData["Title"] = "Ürün Güncelle";
}

<form id="update-product-form" asp-action="UpdateProduct" method="post">
    <input type="hidden" asp-for="ProductId" />

    <div class="box box-primary">
        <div class="box-header with-border">
            <h3 class="box-title">Ürün bilgilerini güncelle</h3>
        </div>
        <div class="box-body">
            <div class="form-group">
                <label asp-for="ProductName">Ürün adı</label>
                <input asp-for="ProductName" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="ProductPrice">Fiyat</label>
                <input asp-for="ProductPrice" type="number" class="form-control" min="0" step="0.01" />
            </div>
            <div class="form-group">
                <label asp-for="CoverImageUrl">Kapak görseli adresi</label>
                <input asp-for="CoverImageUrl" type="url" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="CategoryId">Kategori</label>
                <select asp-for="CategoryId" class="form-control">
                    <option value="">Kategori seçin</option>
                    @foreach (var category in (ViewBag.Categories as IReadOnlyList<ResultCategoryDto> ?? Array.Empty<ResultCategoryDto>()))
                    {
                        <option value="@category.CategoryId">@category.CategoryName</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="ProductDetail.Description">Açıklama</label>
                <textarea asp-for="ProductDetail.Description" class="form-control" rows="5"></textarea>
            </div>
            <div class="form-group">
                <label asp-for="ProductDetail.Information">Ek bilgi</label>
                <textarea asp-for="ProductDetail.Information" class="form-control" rows="3"></textarea>
            </div>
            <div class="form-group">
                <label>Ürün görselleri</label>
                <div id="product-images">
                    @for (var index = 0; index < Model.Images.Count; index++)
                    {
                        <div class="product-image-item well well-sm">
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label asp-for="Images[index].Url">Görsel adresi</label>
                                    <input asp-for="Images[index].Url" class="form-control" data-field="Url" type="url" />
                                </div>
                                <div class="col-md-3 form-group">
                                    <label asp-for="Images[index].AltText">Alternatif metin</label>
                                    <input asp-for="Images[index].AltText" class="form-control" data-field="AltText" />
                                </div>
                                <div class="col-md-2 form-group">
                                    <label asp-for="Images[index].SortOrder">Sıra</label>
                                    <input asp-for="Images[index].SortOrder" class="form-control" data-field="SortOrder" type="number" min="0" />
                                </div>
                                <div class="col-md-1 form-group">
                                    <label>&nbsp;</label>
                                    <button class="btn btn-danger btn-block remove-product-image" type="button"><i class="fa fa-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <button id="add-product-image" class="btn btn-default btn-sm" type="button">
                    <i class="fa fa-plus"></i> Görsel Ekle
                </button>
            </div>
        </div>
        <div class="box-footer">
            <a asp-action="Index" class="btn btn-default">Listeye Dön</a>
            <button type="submit" class="btn btn-primary pull-right">
                <i class="fa fa-save"></i> Değişiklikleri Kaydet
            </button>
        </div>
    </div>
</form>

<template id="product-image-template">
    <div class="product-image-item well well-sm">
        <div class="row">
            <div class="col-md-6 form-group">
                <label>Görsel adresi</label>
                <input class="form-control" data-field="Url" name="Images[__index__].Url" type="url" placeholder="https://..." />
            </div>
            <div class="col-md-3 form-group">
                <label>Alternatif metin</label>
                <input class="form-control" data-field="AltText" name="Images[__index__].AltText" type="text" />
            </div>
            <div class="col-md-2 form-group">
                <label>Sıra</label>
                <input class="form-control" data-field="SortOrder" name="Images[__index__].SortOrder" type="number" min="0" value="__index__" />
            </div>
            <div class="col-md-1 form-group">
                <label>&nbsp;</label>
                <button class="btn btn-danger btn-block remove-product-image" type="button"><i class="fa fa-trash"></i></button>
            </div>
        </div>
    </div>
</template>

<script>
    (function () {
        var form = document.getElementById('update-product-form');
        var container = document.getElementById('product-images');
        var template = document.getElementById('product-image-template');

        function renumberImages() {
            container.querySelectorAll('.product-image-item').forEach(function (item, index) {
                item.querySelectorAll('[data-field]').forEach(function (input) {
                    input.name = 'Images[' + index + '].' + input.dataset.field;
                });
            });
        }

        document.getElementById('add-product-image').addEventListener('click', function () {
            var index = container.querySelectorAll('.product-image-item').length;
            container.insertAdjacentHTML('beforeend', template.innerHTML.replaceAll('__index__', index));
        });

        container.addEventListener('click', function (event) {
            if (event.target.closest('.remove-product-image')) {
                event.target.closest('.product-image-item').remove();
                renumberImages();
            }
        });

        form.addEventListener('submit', renumberImages);
    })();
</script>
