@model IReadOnlyList<SentMessageDto>

@{
    ViewData["Title"] = "Gönderilen Mesajlar";
}

<section class="user-area-panel">
    <div class="user-area-panel-heading">
        <div><p>MESAJLAR</p><h2>Gönderilen mesajlar</h2></div>
        <span>@Model.Count kayıt</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="user-area-empty">
            <i class="fas fa-paper-plane"></i>
            <h3>Gönderilen mesaj bulunmuyor</h3>
            <p>Gönderdiğin mesajlar burada görüntülenecek.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead>
                    <tr><th>#</th><th>Alıcı</th><th>Konu</th><th>Mesaj</th><th>Tarih</th><th>Durum</th></tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Model.Count; index++)
                    {
                        var message = Model[index];
                        <tr>
                            <th>@(index + 1)</th>
                            <td>@message.ReceiverId</td>
                            <td>@message.Subject</td>
                            <td>@message.MessageDetail</td>
                            <td>@message.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <span class="badge @(message.IsRead ? "badge-success" : "badge-secondary")">
                                    @(message.IsRead ? "Okundu" : "Okunmadı")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
